generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("MONGODB_URI")
}

model Component {
  id        String @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  data      Json?

  @@map("components")
}

model Menu {
  id        String @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  items     Json

  @@map("menu")
}

model Admin {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  email    String @unique
  password String

  @@map("admins")
}
